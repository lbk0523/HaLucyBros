{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halucy.local/schemas/run.schema.json",
  "title": "Halucy Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "work_package_id",
    "agent",
    "agent_profile",
    "started_at",
    "ended_at",
    "status",
    "tool_calls",
    "artifacts",
    "commands",
    "scope_report",
    "notes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{8}-[0-9]{3}$"
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[0-9]{4}W[0-9]{2}-[0-9]{3}$"
    },
    "agent": {
      "$ref": "#/$defs/agent_role"
    },
    "agent_profile": {
      "$ref": "#/$defs/non_empty_string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_call"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/reference_list"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command_result"
      }
    },
    "scope_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "touched_paths",
        "target_violations",
        "forbidden_change_violations"
      ],
      "properties": {
        "touched_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "target_violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "forbidden_change_violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "blocked_reason": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ]
      }
    }
  ],
  "$defs": {
    "agent_role": {
      "type": "string",
      "enum": [
        "research",
        "art",
        "implementation",
        "qa",
        "learning_librarian"
      ]
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "reference_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "purpose",
        "inputs",
        "outputs",
        "evidence"
      ],
      "properties": {
        "tool_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "purpose": {
          "$ref": "#/$defs/non_empty_string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_artifact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stderr_artifact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
